{
  "name": "aviso-previo-video",
  "private": true,
  "version": "0.1.0",
  "description": "The Aviso Previo demo video, built with Remotion. See README.md.",
  "scripts": {
    "studio": "node scripts/clips.mjs && remotion studio src/index.ts",
    "render": "node scripts/clips.mjs && remotion render src/index.ts Demo out/aviso-previo-demo.mp4 --codec=h264 --crf=18",
    "still": "remotion still src/index.ts Demo out/frame.png",
    "vo": "node scripts/vo.mjs",
    "assets": "node scripts/capture-ui.mjs && node scripts/prepare-live.mjs",
    "audio": "sh scripts/audio.sh",
    "clips": "node scripts/clips.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.545",
    "@remotion/google-fonts": "^4.0.545",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}